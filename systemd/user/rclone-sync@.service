[Unit]
Description=Rclone sync per istanza %i
Documentation=man:rclone(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/home/frankel/.config/systemd/user/rclone-sync-%i.env
ExecStart=/home/frankel/.bin/rclone_sync.sh ${SOURCE_PATH} ${DEST_PATH}
# 75 = rinvio (rete assente, quota, lock occupato): non è un guasto.
SuccessExitStatus=75
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=6h

[Install]
WantedBy=timers.target
