# Variabili d'ambiente per l'istanza bisync gdrive-pro
# Usato da rclone-bisync@gdrive-pro.service e dal watcher @gdrive-pro
LOCAL_PATH=/home/frankel/GDrive-Pro
REMOTE_PATH=GDrive-Pro:

# Nel vault si sincronizzano solo file stabili: lo stato volatile di Obsidian
# (workspace.json, cestino interno, cache) è escluso.
RCLONE_EXCLUDE_EXTRA=/home/frankel/.config/rclone/exclude_obsidian.txt

# Invariante: questa coppia contiene solo il vault. Qualunque altra voce viene
# migrata in GDrive-F4Frank (vince la versione più recente) oppure eliminata se
# elencata come vietata. Le voci sono separate da '|'.
GUARD_ALLOWED_TOP_LEVEL=Obsidian
GUARD_FORBIDDEN_TOP_LEVEL=Gestione Casa Fokou
GUARD_MIGRATE_TARGET=/home/frankel/GDrive-F4Frank

# Nel vault le cartelle vuote fanno parte della struttura: non rimuoverle.
