# Variabili d'ambiente per l'istanza sync pro-to-mega
# Usato da rclone-sync@pro-to-mega.service
SOURCE_PATH=GDrive-Pro:
DEST_PATH=Mega:GDrive-Pro

# Il backup non cancella mai in massa: oltre questa soglia il run viene
# bloccato e il backup resta intatto (i file rimossi finiscono comunque in
# Mega:_rclone-backup/GDrive-Pro).
SYNC_MAX_DELETE=200
