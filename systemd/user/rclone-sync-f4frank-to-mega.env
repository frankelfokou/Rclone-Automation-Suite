# Variabili d'ambiente per l'istanza sync f4frank-to-mega
# Usato da rclone-sync@f4frank-to-mega.service
SOURCE_PATH=GDrive-F4Frank:
DEST_PATH=Mega:GDrive-F4Frank

# Il backup non cancella mai in massa: oltre questa soglia il run viene
# bloccato e il backup resta intatto (i file rimossi finiscono comunque in
# Mega:_rclone-backup/GDrive-F4Frank).
SYNC_MAX_DELETE=200
