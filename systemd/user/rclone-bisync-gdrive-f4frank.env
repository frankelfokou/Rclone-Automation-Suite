# Variabili d'ambiente per l'istanza bisync gdrive-f4frank
# Usato da rclone-bisync@gdrive-f4frank.service e dal watcher @gdrive-f4frank
LOCAL_PATH=/home/frankel/GDrive-F4Frank
REMOTE_PATH=GDrive-F4Frank:

# Questa coppia non deve mai contenere il vault Obsidian: se compare, viene
# rimosso (in quarantena) da entrambi i lati. Le voci sono separate da '|'.
GUARD_FORBIDDEN_TOP_LEVEL=Obsidian

# Le cartelle vuote si possono rimuovere: qui i documenti sono file, non
# strutture di vault.
EXTRA_BISYNC_FLAGS=--remove-empty-dirs
